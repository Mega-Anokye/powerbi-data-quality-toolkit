model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","Orders","Deliveries"]

ref table Orders
ref table Deliveries
ref table 'Data Checks'
ref table _Measures
